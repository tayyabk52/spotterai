9:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"id":"main-content","tabIndex":-1,"className":"aboutStory Gnr7Kq_story","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"AboutPage\",\"name\":\"About Spotter.ai: The AI Platform Built for Trucking\",\"description\":\"Spotter.ai builds AI software for trucking: a TMS, driver screening, freight market data and a driver app that help carriers run leaner and grow.\",\"url\":\"https://spotter.ai/about\",\"about\":{\"@type\":\"Organization\",\"name\":\"Spotter.ai\",\"url\":\"https://spotter.ai\"}}"}}],["$","noscript",null,{"children":"$a"}],["$","$L14",null,{"mediaQuery":"(min-width: 1024px) and (prefers-reduced-motion: no-preference)","children":[["$","$L15",null,{}],["$","div",null,{"className":"Gnr7Kq_metrics","children":[["$","dl",null,{"children":[["$","div","Global Operations Network",{"children":[["$","dt",null,{"children":"Global Operations Network"}],["$","dd",null,{"children":"500+"}]]}],["$","div","Live Dispatch & Support",{"children":[["$","dt",null,{"children":"Live Dispatch & Support"}],["$","dd",null,{"children":"24/7"}]]}],["$","div","YoY Net Revenue Growth",{"children":[["$","dt",null,{"children":"YoY Net Revenue Growth"}],["$","dd",null,{"children":"70%"}]]}],["$","div","Capital Raised Efficiently",{"children":[["$","dt",null,{"children":"Capital Raised Efficiently"}],["$","dd",null,{"children":"$$4.9MM"}]]}]]}],["$","p",null,{"className":"Gnr7Kq_figuresSource","children":["$","a",null,{"href":"https://spotter.ai/about","children":"Source: spotter.ai/about · October 8, 2026"}]}]]}],["$","section",null,{"id":"about-reality","aria-labelledby":"about-reality-title","className":"Gnr7Kq_chapter Gnr7Kq_light Gnr7Kq_execution","children":["$","div",null,{"className":"Gnr7Kq_container Gnr7Kq_split","children":[["$","$L16",null,{"className":"Gnr7Kq_sectionHead","children":[["