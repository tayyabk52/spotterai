21:["$","$L20",null,{"id":"driver-autonomy","number":"04","label":"Carrier Optionality","title":"Built for independent owner-operators.","description":"Run with complete operational autonomy under select partner motor carrier authorities. Accept or decline recommendations with full freedom and zero penalties.","asset":{"kind":"image","id":"driver-phone-mockup","src":"/images/driversapp/phone-mockup.png","poster":"/images/driversapp/phone-mockup.png","sourceFile":"phone.679d067b47dd3515a58c.png","sourceUrl":"https://spotter.ai/static/media/phone.679d067b47dd3515a58c.png","source":"source page","license":"Authentic product screenshot from spotter.ai/driversapp","alt":"Mobile device frame showcasing Spotter load offers with instant acceptance options","width":590,"height":1106,"duration":0,"bytes":190231},"features":[{"title":"Accept or Reject Authority","description":"Full discretion over your route choices. Accept offers that fit your schedule or decline without penalty."},{"title":"Vetted MC Networks","description":"Operate under established, top-rated motor carrier authorities with insured broker relationships and fast factoring."},{"title":"Frictionless Documentation","description":"Digital rate confirmations, automated bill of lading capture, and streamlined check calls right from your phone."}],"pinned":false}]
22:["$","$L20",null,{"id":"driver-settlement","number":"05","label":"Visibility & Performance","title":"Instant settlements and connected dispatch.","description":"Track loaded miles, monitor your personal driver score, and streamline weekly settlements. Fully connected to Spotter TMS for carrier transparency.","asset":{"kind":"image","id":"driver-step3-loads","src":"/images/driversapp/step3-loads.webp","poster":"/images/driversapp/step3-loads.webp","sourceFile":"step3_spotter_loads.webp","sourceUrl":"https://spotter.ai/videos/gifs/step3_spotter_loads.webp","source":"source page","license":"Authentic in-app walkthrough animation from spotter.ai/driversapp","alt":"Spotter Driver App interface displaying ranked load recommendations and transparent rate calculation","width":1124,"height":956,"duration":0,"bytes":1921294},"features":[{"title":"Real-Time Pay Tracking","description":"Clear breakdown of weekly gross earnings, fuel advances, and scheduled settlement dates with zero hidden fees."},{"title":"Performance Insights","description":"Monitor on-time delivery rates, verified safety metrics, and historical lane yields to unlock premium freight tiers."},{"title":"Spotter Suite Sync","description":"Direct integration with Spotter TMS and Sentinel safety monitoring keeps dispatchers and drivers aligned."}],"pinned":false,"light":true}]
