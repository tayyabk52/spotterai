17:["$","$1","c",{"children":[["$","main",null,{"id":"main-content","tabIndex":-1,"className":"driverStory _0s3fAq_story","children":[["$","noscript",null,{"children":"$1c"}],["$","$L1e",null,{"children":[["$","$L1f",null,{}],["$","$L20",null,{"id":"driver-schedule","number":"01","label":"Personal Scheduling","title":"Set your hours. Protect your home time.","description":"Define when you are ready to roll and lock in planned return windows before picking up your next run. The app synchronizes dispatch offers with your personal calendar.","asset":{"kind":"image","id":"driver-step1-ready","src":"/images/driversapp/step1-ready.webp","poster":"/images/driversapp/step1-ready.webp","sourceFile":"step1_spotter_ready.webp","sourceUrl":"https://spotter.ai/videos/gifs/step1_spotter_ready.webp","source":"source page","license":"Authentic in-app walkthrough animation from spotter.ai/driversapp","alt":"Spotter Driver App interface demonstrating driver availability and schedule setup","width":1164,"height":1000,"duration":0,"bytes":1940678},"features":[{"title":"Ready-Now Status","description":"Signal your availability to the network with exact readiness dates, equipment readiness, and preferred departure times."},{"title":"Guaranteed Home Time","description":"Lock in return windows so the dispatch algorithm only recommends return routes that bring you home on schedule."},{"title":"Zero Forced Scheduling","description":"Eliminate unwanted layovers and unexpected dispatch gaps with predictive calendar visibility."}],"pinned":true}],["$","$L20",null,{"id":"driver-nogo","number":"02","label":"Destination Defense","title":"Blacklist bad markets. Protect your rate per mile.","description":"Select the destination markets you want to run to and avoid unprofitable freight deserts. The interactive NO-GO map ensures you never get trapped in deadhead dead zones.","asset":{"kind":"image","id":"driver-step2-markets","src":"/images/driversapp/step2-markets.webp","poster":"/images/driversapp/step2-markets.webp","sourceFile":"step2_spotter_markets.webp","sourceUrl":"https://spotter.ai/videos/gifs/step2_spotter_markets.webp","source":"source page","license":"Authentic in-app walkthrough animation from spotter.ai/driversapp","alt":"Spotter Driver App interface demonstrating market selection and NO-GO map exclusion","width":1240,"height":900,"duration":0,"bytes":5880182},"features":[{"title":"Interactive NO-GO Map","description":"Highlight regions and metros you decline to enter. The algorithm automatically filters out loads terminating in those territories."},{"title":"Destination Targeting","description":"Specify high-volume freight corridors with reliable outbound load volume to maximize your weekly revenue per mile."},{"title":"Deadhead Reduction","description":"Evaluate every destination by its backhaul viability before you commit to rolling."}],"pinned":true}],["$","$L20",null,{"id":"driver-scoring","number":"03","label":"Machine Matching","title":"Highest-score recommendations delivered first.","description":"Spotter evaluates freight opportunities across thousands of market signals. Loads are scored and ranked in real time by net revenue yield, deadhead miles, and delivery certainty.","asset":{"id":"driver-matching","src":"/videos/driversapp/driver-matching.mp4","poster":"/images/driversapp/driver-matching-poster.jpg","sourceFile":"Freight_network_data_visualization_1080p_20261008180845.mp4","sourceUrl":"/brand/driverapp-videos/Freight_network_data_visualization_1080p_20261008180845.mp4","source":"generated","license":"Owner-provided generated film. All-intra H.264 derivative encoded with GOP=1 for scroll scrubbing.","alt":"Abstract 3D architectural freight network with converging teal velocity lines","width":1280,"height":720,"duration":6,"bytes":4914962},"features":[{"title":"Multi-Factor Load Score","description":"Every offer receives a composite score reflecting rate per mile, deadhead distance, fuel index, and lane turnaround speed."},{"title":"Ranked Recommendation Feed","description":"Skip endless load-board scrolling. Review tailored recommendations pre-sorted by highest operational profitability."},{"title":"Transparent Rate Cards","description":"Review gross pay, estimated fuel expenditure, and net take-home before accepting or declining."}],"pinned":true,"scrub":true}],"$L21","$L22","$L23","$L24"]}]]}],["$L25","$L26","$L27"],"$L28"]}]
