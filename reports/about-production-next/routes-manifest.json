      "routeKeys": {},
      "namedRegex": "^/api/quote(?:/)?$"
    },
    {
      "page": "/claims-os",
      "regex": "^/claims\\-os(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/claims\\-os(?:/)?$"
    },
    {
      "page": "/driversapp",
      "regex": "^/driversapp(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/driversapp(?:/)?$"
    },
    {
      "page": "/extension",
      "regex": "^/extension(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/extension(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/lens",
      "regex": "^/lens(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lens(?:/)?$"
    },
    {
      "page": "/loan-calculators",
      "regex": "^/loan\\-calculators(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/loan\\-calculators(?:/)?$"
    },
    {
      "page": "/opengraph-image",
      "regex": "^/opengraph\\-image(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/opengraph\\-image(?:/)?$"
    },
    {
      "page": "/request-quote",
      "regex": "^/request\\-quote(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/request\\-quote(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sentinel",
      "regex": "^/sentinel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sentinel(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
